<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Bjs.Cms.Api</RootNamespace>
    <AssemblyName>Bjs.Cms.Api</AssemblyName>
    <!--<InvariantGlobalization>true</InvariantGlobalization>-->
  </PropertyGroup>

  <!--
    Normal builds use EF Core (SQLite or SQL Server, chosen in appsettings).
    "dotnet build -p:NoEf=true" compiles without EF Core and uses the JSON-file store (dev/test only).
  -->
  <PropertyGroup Condition="'$(NoEf)' == 'true'">
    <DefineConstants>$(DefineConstants);NO_EF</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(NoEf)' != 'true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Condition="'$(NoEf)' == 'true'">
    <Compile Remove="Data/Ef/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cms.Contracts\Cms.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Seed\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="EmailTemplates\**\*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
