@page
@using System.Text.Json
@using Bjs.Cms.Contracts
@using BJS.Master.Pages
@using BJS.Master.Services
@model BJS.Master.Pages.IndexModel
@{
    Layout = null;

    // Everything below comes from the CMS (Model.C). Editors change it in the dashboard; nothing here is hard-coded content.
    var c = Model.C;
    var g = c.General;
    var cms = Model.CmsBase;

    string M(string? src) => SiteHelpers.Media(src, cms);
    string Abs(string? src)
    {
        var m = M(src);
        if (string.IsNullOrEmpty(m)) return "";
        return m.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? m : c.SiteUrl + m;
    }
    Dictionary<string, string> Meta(Seo s) => new()
    {
        ["title"] = string.IsNullOrWhiteSpace(s.Title) ? g.SiteName : s.Title,
        ["description"] = string.IsNullOrWhiteSpace(s.Description) ? g.Tagline : s.Description,
        ["image"] = Abs(string.IsNullOrWhiteSpace(s.Image) ? g.DefaultShareImage : s.Image),
    };

    // The page's JavaScript swaps the title/description as visitors move between sections.
    var metaMap = new Dictionary<string, Dictionary<string, string>>
    {
        ["hero"] = Meta(c.Hero.Seo),
        ["about"] = Meta(c.About.Seo),
        ["profiles"] = Meta(c.Leadership.Seo),
        ["history"] = Meta(c.History.Seo),
        ["gallery"] = Meta(c.SocialWall.Seo),
        ["activities"] = Meta(c.Activities.Seo),
        ["contact"] = Meta(c.Contact.Seo),
        ["tuition"] = Meta(c.Tuition.Seo),
        ["privacy"] = Meta(c.Privacy.Seo),
    };
    var home = Meta(c.Hero.Seo);
    var homeTitle = home["title"];
    var homeDesc = home["description"];
    var homeImage = home["image"];
    var homeUrl = c.SiteUrl + "/";

    // A link in the menu or footer. Links to a section of this page get data-target so the page scrolls instead of reloading.
    void Anchor(string label, string url, bool newTab, string? number = null)
    {
        var target = SiteRoutes.AnchorFor(url);
        var external = SiteRoutes.IsExternal(url) || newTab;
        <a href="@url" data-target="@target" target="@(external ? "_blank" : null)" rel="@(external ? "noopener noreferrer" : null)">@if (number != null) {<span>@number</span>}@label</a>
    }

    var logo = M(g.Logo);
    var heroIcons = new List<(string Icon, string Href)>();
    foreach (var platform in new[] { "facebook", "email", "whatsapp", "youtube", "x", "twitter", "tiktok", "linkedin", "instagram" })
    {
        if (platform == "email")
        {
            if (!string.IsNullOrWhiteSpace(g.PublicEmail)) heroIcons.Add(("email", "mailto:" + g.PublicEmail));
        }
        else
        {
            var link = g.Social.FirstOrDefault(s => s.Platform == platform);
            if (link != null) heroIcons.Add((platform, link.Url));
        }
    }
    var cd = c.Contact.Details;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title id="page-title">@homeTitle</title>
    <meta name="description" id="meta-description" content="@homeDesc" />
    <meta property="og:title" id="og-title" content="@homeTitle" />
    <meta property="og:description" id="og-description" content="@homeDesc" />
    <meta property="og:type" content="website" />
    <meta property="og:url" id="og-url" content="@homeUrl" />
    <meta property="og:image" id="og-image" content="@homeImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" id="twitter-title" content="@homeTitle" />
    <meta name="twitter:description" id="twitter-description" content="@homeDesc" />
    <meta name="twitter:image" id="twitter-image" content="@homeImage" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="~/css/site.min.css" />

    @if (!string.IsNullOrWhiteSpace(g.GtmId))
    {
        <!-- Google Tag Manager -->
        <script>
            (function (w, d, s, l, i) {
                w[l] = w[l] || []; w[l].push({
                    'gtm.start':
                        new Date().getTime(), event: 'gtm.js'
                }); var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                        'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', '@g.GtmId');
        </script>
        <!-- End Google Tag Manager -->
    }

    <template id="meta-map">@Html.Raw(JsonSerializer.Serialize(metaMap))</template>
</head>
<body>
    @if (!string.IsNullOrWhiteSpace(g.GtmId))
    {
        <noscript>
            <iframe src="https://www.googletagmanager.com/ns.html?id=@g.GtmId" height="0" width="0" style="display:none;visibility:hidden"></iframe>
        </noscript>
    }
    <div class="topbar">
        <a href="/" class="site-logo">
            <img src="@logo" alt="@g.SiteName" />
        </a>
        <button id="menu-toggler" aria-label="Menu">
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
        </button>
    </div>

    <nav class="navpanel" id="navpanel">
        @for (var i = 0; i < c.Menu.Items.Count; i++)
        {
            var item = c.Menu.Items[i];
            Anchor(item.Label, item.Url, item.NewTab, (i + 1).ToString("00"));
        }
    </nav>

    <!-- HERO -->
    <section id="hero">
        <div class="hero-banners" id="bannerBox" data-interval="@(Math.Max(2, c.Hero.AutoplaySeconds) * 1000)">
            @for (var i = 0; i < c.Hero.Slides.Count; i++)
            {
                var slide = c.Hero.Slides[i];
                var srcset = SiteHelpers.Srcset(slide.Image, new[] { 480, 800 }, 1152, cms);
                <div class="banner b@((i % 5) + 1)@(i == 0 ? " active" : "")">
                    <img src="@M(slide.Image)" srcset="@(srcset.Length > 0 ? srcset : null)" sizes="@(srcset.Length > 0 ? "100vw" : null)" alt="@slide.Alt" width="1152" height="864"
                         fetchpriority="@(i == 0 ? "high" : null)" loading="@(i == 0 ? null : "lazy")" decoding="async" onerror="this.remove()">
                </div>
            }
        </div>

        <div class="dots" id="dots"></div>
        <div class="hero-overlay">
            <div class="hero-left">
                <div class="inner-wrapper">
                    @if (logo.Length > 0)
                    {
                        <div class="site-logo"><img src="@logo" alt="@g.SiteName" /></div>
                    }
                    <h1>@c.Hero.HeadingLead <span class="highlight">@c.Hero.HeadingHighlight</span></h1>
                    @Html.Raw(c.Hero.Text)
                    @if (c.Hero.ShowSocialIcons && heroIcons.Count > 0)
                    {
                        <ul id="sm-icons">
                            @foreach (var icon in heroIcons)
                            {
                                <li>
                                    <a href="@icon.Href" target="_blank" rel="noopener noreferrer" aria-label="@icon.Icon"><img src="/images/@(icon.Icon).svg" alt="" /></a>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="band-white">
        <div class="wrap about-grid">
            @{
                var card = c.About.ImageCard;
                var hasImage = !string.IsNullOrWhiteSpace(card.Image);
            }
            <div class="about-img@(hasImage ? " has-image" : "")" data-caption="@card.Caption">
                @if (hasImage)
                {
                    <img src="@M(card.Image)" alt="@card.Alt" loading="lazy" decoding="async" />
                }
            </div>
            <div class="about-text">
                <div class="eyebrow">@c.About.Eyebrow</div>
                <h2>@c.About.Heading</h2>
                @Html.Raw(c.About.Text)
                @if (c.About.Stats.Count > 0)
                {
                    <div class="stat-row">
                        @foreach (var stat in c.About.Stats)
                        {
                            <div><strong>@stat.Value</strong><span>@stat.Label</span></div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- PROFILES / LEADERSHIP -->
    <section id="profiles" class="band-sage">
        <div class="wrap">
            <div class="sect-head">
                <div class="eyebrow">@c.Leadership.Eyebrow</div>
                <h2>@c.Leadership.Heading</h2>
            </div>
            <div class="profile-grid">
                @foreach (var person in c.Leadership.People)
                {
                    var srcset = SiteHelpers.Srcset(person.Image, new[] { 320, 480 }, 640, cms);
                    var alt = string.IsNullOrWhiteSpace(person.Designation) ? person.Name : $"{person.Name}, {person.Designation}";
                    <button class="p-card" data-bio-id="@person.Id"><div class="fill">
                        @if (!string.IsNullOrWhiteSpace(person.Image))
                        {
                            <img src="@M(person.Image)" srcset="@(srcset.Length > 0 ? srcset : null)" sizes="(max-width:520px) 92vw, (max-width:820px) 46vw, 380px" alt="@alt" width="480" height="640" loading="lazy" decoding="async" onerror="this.remove()">
                        }
                    </div><div class="p-strip"><b>@person.Name</b><span>@person.Designation</span></div></button>
                }
            </div>
        </div>
    </section>

    <!-- HISTORY -->
    <section id="history" class="band-white">
        <div class="wrap history">
            <div class="sect-head">
                <div class="eyebrow">@c.History.Eyebrow</div>
                <h2>@c.History.Heading</h2>
            </div>
            @Html.Raw(c.History.Text)
        </div>
    </section>

    <!-- SOCIAL WALL -->
    <partial name="_Gallery" model='new GalleryView(c.SocialWall, "gallery", "band-gold", "galFilters", "galGrid", cms)' />

    <!-- ACTIVITIES & FACILITIES -->
    <partial name="_Gallery" model='new GalleryView(c.Activities, "activities", "band-slate", "actFilters", "actGrid", cms)' />

    <!-- CONTACT -->
    <section id="contact">
        @if (!string.IsNullOrWhiteSpace(c.Contact.MapEmbedUrl))
        {
            <div class="map-embed-full">
                <iframe src="@c.Contact.MapEmbedUrl" title="Map showing the school's location" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        }
        <div class="wrap">
            <div class="sect-head"><div class="eyebrow">@c.Contact.Eyebrow</div><h2>@c.Contact.Heading</h2></div>
            <div class="contact-grid">
                <div>
                    @if (!Model.SubmissionSuccessful)
                    {
                        <form method="post" id="contact-form">
                            <div class="field">
                                <label asp-for="contact.fullname">Full name</label>
                                <input asp-for="contact.fullname"
                                       autocomplete="name"
                                       required />
                                <span asp-validation-for="contact.fullname" class="validation-message"></span>
                            </div>
                            <div class="field">
                                <label asp-for="contact.email">Email address</label>
                                <input asp-for="contact.email"
                                       type="email"
                                       autocomplete="email"
                                       required />
                                <span asp-validation-for="contact.email" class="validation-message"></span>
                            </div>
                            <div class="field">
                                <label asp-for="contact.message">Message</label>
                                <textarea asp-for="contact.message"
                                          rows="6"
                                          required></textarea>
                                <span asp-validation-for="contact.message" class="validation-message"></span>
                            </div>
                            <button class="btn" type="submit">Send enquiry</button>
                            <input type="hidden" asp-for="contact.hpToken" aria-label="hp" />
                            <div asp-validation-summary="All"></div>
                        </form>
                    }
                    <div id="contact-result" class="hidden"></div>
                </div>
                <div class="contact-details">
                    @if (!string.IsNullOrWhiteSpace(cd.Title)) { <h3>@cd.Title</h3> }
                    @if (!string.IsNullOrWhiteSpace(cd.Address))
                    {
                        <p>
                            @{ var lines = cd.Address.Split('\n'); }
                            @for (var i = 0; i < lines.Length; i++)
                            {
                                <text>@lines[i]</text>
                                if (i < lines.Length - 1) { <br> }
                            }
                        </p>
                    }
                    <div class="contact-socials">
                        @if (cd.Phones.Count > 0)
                        {
                            <p>
                                <img src="/images/whatsapp.svg" alt=""> Tel:
                                @for (var i = 0; i < cd.Phones.Count; i++)
                                {
                                    if (i > 0) { <text> | </text> }
                                    <a href="@SiteHelpers.PhoneHref(cd.Phones[i])">@cd.Phones[i]</a>
                                }
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(cd.Email))
                        {
                            <p><img src="/images/email.svg" alt=""> Email: <a href="mailto:@cd.Email">@cd.Email</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(cd.YouTube.Url))
                        {
                            <p><img src="/images/youtube.svg" alt=""> YouTube: <a href="@cd.YouTube.Url" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(cd.YouTube.Label) ? cd.YouTube.Url : cd.YouTube.Label)</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(cd.Facebook.Url))
                        {
                            <p><img src="/images/facebook.svg" alt=""> Facebook: <a href="@cd.Facebook.Url" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(cd.Facebook.Label) ? cd.Facebook.Url : cd.Facebook.Label)</a></p>
                        }
                        @if (!string.IsNullOrWhiteSpace(cd.WhatsApp.Url))
                        {
                            <p><img src="/images/whatsapp.svg" alt=""> WhatsApp: <a href="@cd.WhatsApp.Url" target="_blank" rel="noopener noreferrer">@(string.IsNullOrWhiteSpace(cd.WhatsApp.Label) ? cd.WhatsApp.Url : cd.WhatsApp.Label)</a></p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TUITION / FEES -->
    @{
        var btn = c.Tuition.Button;
        var panelBtn = btn.Action == "panel";
    }
    <section id="tuition" class="band-sand">
        <div class="wrap donate-box">
            <div class="eyebrow">@c.Tuition.Eyebrow</div>
            <h2>@c.Tuition.Heading</h2>
            @Html.Raw(c.Tuition.Text)
            @if (!string.IsNullOrWhiteSpace(btn.Label))
            {
                if (panelBtn)
                {
                    <button class="btn gold" id="bank-btn" type="button">@btn.Label</button>
                }
                else if (!string.IsNullOrWhiteSpace(btn.Url))
                {
                    <a class="btn gold" href="@btn.Url" target="@(btn.NewTab ? "_blank" : null)" rel="@(btn.NewTab ? "noopener noreferrer" : null)">@btn.Label</a>
                }
            }
        </div>
    </section>

    <!-- PRIVACY -->
    <section id="privacy" class="band-white">
        <div class="wrap legal">
            <div class="eyebrow">@c.Privacy.Eyebrow</div>
            <h2>@c.Privacy.Heading</h2>
            @Html.Raw(c.Privacy.Text)
        </div>
    </section>

    <!-- FOOTER -->
    @{
        var footLogo = M(string.IsNullOrWhiteSpace(c.Footer.Logo) ? g.Logo : c.Footer.Logo);
    }
    <footer>
        <div class="wrap">
            <div class="foot-grid">
                <div class="foot-brand">
                    <div>
                        <a href="/" class="site-logo">
                            <img src="@footLogo" alt="@g.SiteName" />
                        </a>
                    </div>
                    <p>@c.Footer.Tagline</p>
                </div>
                <div>
                    <h5>@c.Footer.Explore.Title</h5>
                    @foreach (var l in c.Footer.Explore.Links) { Anchor(l.Label, l.Url, l.NewTab); }
                </div>
                <div>
                    <h5>@c.Footer.Connect.Title</h5>
                    @foreach (var l in c.Footer.Connect.Links) { Anchor(l.Label, l.Url, l.NewTab); }
                </div>
            </div>
            <div class="foot-bottom">
                <span>@SiteHelpers.ReplaceYear(c.BottomStrip.Left)</span>
                <span>@SiteHelpers.ReplaceYear(c.BottomStrip.Right)</span>
            </div>
        </div>
    </footer>

    <div class="scrim" id="scrim"></div>
    <div class="slidein" id="slidein">
        <button class="close-x" id="slideClose">✕</button>
        <div id="slideBody"></div>
    </div>
    <div class="lb" id="lightbox">
        <button class="close-x" id="lbClose">✕</button>
        <button class="lb-nav prev" id="lbPrev" aria-label="Previous image">‹</button>
        <div class="lb-slides" id="lbSlides"></div>
        <button class="lb-nav next" id="lbNext" aria-label="Next image">›</button>
        <div class="lb-dots" id="lbDots"></div>
        <div class="lb-counter" id="lbCounter"></div>
    </div>
    <button id="backTop" aria-label="Back to top">↑</button>

    @if (g.CookieNoticeEnabled)
    {
        <div id="cookies-directive">
            <p>@g.CookieNoticeText <a href="#privacy">@g.CookieLinkLabel</a>.</p>
            <span class="cc-close" id="ccClose">✕ Close</span>
        </div>
    }

    <!-- HIDDEN MODAL CONTENT TEMPLATES -->
    @foreach (var person in c.Leadership.People)
    {
        <template id="bio-@person.Id">
            <h3>@(string.IsNullOrWhiteSpace(person.Bio.Title) ? person.Name : person.Bio.Title)</h3><span class="role">@person.Designation</span>
            @Html.Raw(person.Bio.Text)
        </template>
    }
    @if (panelBtn)
    {
        <template id="bank-details">
            <h3>@c.Tuition.Panel.Title</h3>
            @Html.Raw(c.Tuition.Panel.Text)
        </template>
    }
    <script src="~/js/site.min.js"></script>
</body>
</html>
