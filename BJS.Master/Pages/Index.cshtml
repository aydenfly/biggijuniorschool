    <!-- CONTACT -->
    <section id="contact">
        <div class="map-embed-full">
            <iframe src="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3141.949947154748!2d31.3590051585726!3d2.3580899266762536!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zMsKwMjEnMjkuNiJOIDMxwrAyMSczOC41IkU!5e1!3m2!1sen!2sug!4v1790765875338!5m2!1sen!2sug" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="wrap">
            <div class="sect-head"><div class="eyebrow">Get in touch</div><h2>We'd love to hear from you</h2></div>
            <div class="contact-grid">
                <div>
                    @if (!Model.SubmissionSuccessful)
                    {
                        <form method="post" id="contact-form">

                            <div class="field">
                                <label asp-for="contact.fullname">Full name</label>
                                <input asp-for="contact.fullname"
                                       autocomplete="name"
                                       required />
                                <span asp-validation-for="contact.fullname" class="validation-message"></span>
                            </div>

                            <div class="field">
                                <label asp-for="contact.email">Email address</label>
                                <input asp-for="contact.email"
                                       type="email"
                                       autocomplete="email"
                                       required />
                                <span asp-validation-for="contact.email" class="validation-message"></span>
                            </div>

                            <div class="field">
                                <label asp-for="contact.message">Message</label>
                                <textarea asp-for="contact.message"
                                          rows="6"
                                          required></textarea>
                                <span asp-validation-for="contact.message" class="validation-message"></span>
                            </div>

                            <button class="btn" type="submit">Send enquiry</button>
                            <input type="hidden" asp-for="contact.hpToken" aria-label="hp" />
                            <div asp-validation-summary="All"></div>
                        </form>
                    }
                    <div id="contact-result" class="hidden"></div>
                </div>
                <div class="contact-details">
                    <h3>Biggi Junior School</h3>
                    <p>
                        Ndaba Village, Marama Parish, Panyimur Sub County,<br>
                        Jonam County, Pakwach District, Uganda.
                    </p>
                    <div class="contact-socials">
                        <p><img src="/Images/whatsapp.svg"> Tel: <a href="tel:+256755293211">+256755293211</a></p>
                        <p><img src="/Images/email.svg"> Email: <a href="mailto:info@biggijuniorschool.com">info@biggijuniorschool.com</a></p>
                        <p><img src="/Images/youtube.svg"> YouTube: <a href="https://www.youtube.com/channel/UCgpxHtVUFLQQI5LgR_dwZFA" target="_blank" rel="noopener noreferrer">@@BiggiJuniorSchool</a></p>
                        <p><img src="/Images/facebook.svg"> Facebook: <a href="https://www.facebook.com/BiggiJuniorSchool" target="_blank" rel="noopener noreferrer">@@BiggiJuniorSchool</a></p>
                        <p><img src="/Images/whatsapp.svg"> WhatsApp: <a href="https://api.whatsapp.com/send?phone=256755293211" target="_blank" rel="noopener noreferrer">@@BiggiJuniorSchool</a></p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TUITION / FEES -->
    <section id="tuition" class="band-sand">
        <div class="wrap donate-box">
            <div class="eyebrow">Tuition &amp; Fees</div>
            <h2>Fees, bursaries, and how to give</h2>
            <p>School fees cover tuition, meals, and learning materials for each term. Detailed termly fee structures by class are shared directly with parents at enrolment and can be requested through the Contacts section below.</p>
            <p>Every term, some of our brightest pupils risk missing class simply because their families cannot afford tuition or scholastic materials. That's why we run a bursary programme, supported by donors and well-wishers, so that no child's circumstances decide whether they get to learn.</p>
            <ul class="donate-list">
                <li>Fund tuition for a pupil in need</li>
                <li>Provide scholastic materials — books, pens, uniforms</li>
                <li>Sponsor a full bursary for a term or a year</li>
                <li>Support general school running costs</li>
            </ul>
            <button class="btn gold" id="bank-btn" type="button">Support a bursary</button>
        </div>
    </section>

    <!-- PRIVACY -->
    <section id="privacy" class="band-white">
        <div class="wrap legal">
            <div class="eyebrow">Legal</div>
            <h2>Privacy &amp; Cookies</h2>
            <p>Biggi Junior School respects the privacy of everyone who visits this website, including parents, pupils, donors, and partners.</p>
            <h4>Information we collect</h4>
            <p>We only collect information you choose to share with us, such as your name, email, and message when you use our enquiry form.</p>
            <h4>How we use it</h4>
            <p>Information submitted through this site is used solely to respond to your enquiry or process your support for the school, and is never sold to third parties.</p>
            <h4>Cookies</h4>
            <p>This site may use minimal cookies to remember basic preferences during your visit. No tracking or advertising cookies are used.</p>
            <h4>Contact us</h4>
            <p>If you have questions about this policy, please reach out via the enquiry form in our contact section.</p>
        </div>
    </section>

