                </div>
                <div>
                    <h5>Connect</h5>
                    <a href="/contact" data-target="contact">Get In Touch</a><a href="/tuition" data-target="tuition">Tuition &amp; Fees</a><a href="/privacy" data-target="privacy">Privacy &amp; Cookies</a>
                    <a href="https://www.youtube.com/channel/UCzIXxvUv0q4pDYLgv3P1eeg" target="_blank" rel="nofollow noopener">YouTube Channel</a>
                </div>
            </div>
            <div class="foot-bottom">
                <span>© 2026 Biggi Junior School — Pakwach.</span>
                <span>Built with care for our learners.</span>
            </div>
        </div>
    </footer>

