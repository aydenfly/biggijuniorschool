<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BuildBundlerMinifier2022" Version="2.9.11" />
    <!-- Mailjet.Api and HtmlAgilityPack.NetCore were only used to send the contact email.
         That now happens in the CMS, so the website no longer needs them. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Shared content models (same classes the CMS API uses) -->
    <ProjectReference Include="..\Cms.Contracts\Cms.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Snapshot used only if the CMS cannot be reached before the first successful fetch -->
    <None Update="App_Data\content-fallback.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
